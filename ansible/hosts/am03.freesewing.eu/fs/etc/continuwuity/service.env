# Variables to control the continuwuity service

# Where to find the config
CONTINUWUITY_CONFIG_ROOT=/etc/continuwuity

# Where to store the data
CONTINUWUITY_DATA_ROOT=/data/continuwuity

# Where to write the logs
CONTINUWUITY_LOGS_ROOT=/var/log/continuwuity

# Container image to run
CONTINUWUITY_CONTAINER_IMAGE=jadedblueeyes/continuwuity

# Container tag to run
CONTINUWUITY_CONTAINER_TAG=v26.8.1-maxperf
